{
    "key": "group_lp_theme_options",
    "title": "Ajustes Generales - Latin Party Eventos",
    "fields": [
        {
            "key": "tab_opt_brand",
            "label": "Identidad y Marca",
            "type": "tab"
        },
        {
            "key": "field_lp_site_logo",
            "label": "Logo Oficial de la Empresa",
            "name": "lp_site_logo",
            "type": "image",
            "instructions": "Sube el logo oficial (PNG transparente recomendado).",
            "return_format": "array",
            "preview_size": "medium"
        },
        {
            "key": "field_lp_primary_phone",
            "label": "Teléfono Principal",
            "name": "lp_primary_phone",
            "type": "text",
            "default_value": "+57 311 8487785"
        },
        {
            "key": "field_lp_whatsapp_number",
            "label": "Número WhatsApp (código de país sin espacios ni símbolos)",
            "name": "lp_whatsapp_number",
            "type": "text",
            "default_value": "573118487785",
            "instructions": "Ejemplo: 573118487785"
        },
        {
            "key": "field_lp_whatsapp_link",
            "label": "Enlace Directo WhatsApp / wa.link (Opcional)",
            "name": "lp_whatsapp_link",
            "type": "url",
            "default_value": "https://wa.link/p2g3qg"
        },
        {
            "key": "field_lp_whatsapp_default_message",
            "label": "Mensaje Predeterminado de WhatsApp",
            "name": "lp_whatsapp_default_message",
            "type": "textarea",
            "rows": 2,
            "default_value": "¡Hola Latin Party Eventos! Deseo solicitar asesoría para mi evento."
        },
        {
            "key": "field_lp_contact_email",
            "label": "Correo de Contacto / Cotizaciones",
            "name": "lp_contact_email",
            "type": "email",
            "default_value": "contacto@latinpartyeventos.com"
        },
        {
            "key": "field_lp_pqr_email",
            "label": "Correo PQR",
            "name": "lp_pqr_email",
            "type": "email",
            "default_value": "pqr@latinpartyeventos.com"
        },
        {
            "key": "field_lp_location",
            "label": "Ubicación / Ciudad Sede",
            "name": "lp_location",
            "type": "text",
            "default_value": "Bogotá, Colombia"
        },
        {
            "key": "tab_opt_social",
            "label": "Redes Sociales",
            "type": "tab"
        },
        {
            "key": "field_lp_facebook",
            "label": "Enlace de Facebook",
            "name": "lp_facebook",
            "type": "url",
            "default_value": "https://www.facebook.com/share/17BwWKdEBR/"
        },
        {
            "key": "field_lp_instagram",
            "label": "Enlace de Instagram",
            "name": "lp_instagram",
            "type": "url",
            "default_value": "https://www.instagram.com/latinparty?igsh=cWtsYWliY2pod2p5"
        },
        {
            "key": "field_lp_tiktok",
            "label": "Enlace de TikTok (Opcional)",
            "name": "lp_tiktok",
            "type": "url",
            "default_value": ""
        },
        {
            "key": "field_lp_youtube",
            "label": "Enlace de YouTube (Opcional)",
            "name": "lp_youtube",
            "type": "url",
            "default_value": ""
        },
        {
            "key": "tab_opt_header_footer",
            "label": "Cabecera y Pie de Página",
            "type": "tab"
        },
        {
            "key": "field_lp_show_topbar",
            "label": "Mostrar Barra Superior (Topbar)",
            "name": "lp_show_topbar",
            "type": "true_false",
            "ui": 1,
            "default_value": 1
        },
        {
            "key": "field_lp_header_btn_show",
            "label": "Mostrar Botón en Cabecera",
            "name": "lp_header_btn_show",
            "type": "true_false",
            "ui": 1,
            "default_value": 1
        },
        {
            "key": "field_lp_header_btn_text",
            "label": "Texto del Botón de Cabecera",
            "name": "lp_header_btn_text",
            "type": "text",
            "default_value": "Cotizar"
        },
        {
            "key": "field_lp_header_btn_action",
            "label": "Acción del Botón de Cabecera",
            "name": "lp_header_btn_action",
            "type": "select",
            "choices": {
                "whatsapp": "Abrir chat directo de WhatsApp",
                "contacto": "Ir a la página de Contacto"
            },
            "default_value": "whatsapp"
        },
        {
            "key": "field_lp_footer_about",
            "label": "Descripción de la Empresa en el Footer",
            "name": "lp_footer_about",
            "type": "textarea",
            "rows": 3,
            "default_value": "En Latin Party Eventos nos especializamos en diseñar experiencias memorables que combinan profesionalismo, creatividad y excelencia en cada detalle."
        },
        {
            "key": "field_lp_copyright",
            "label": "Texto de Copyright en el Footer",
            "name": "lp_copyright",
            "type": "text",
            "default_value": "Latin Party Eventos. Todos los derechos reservados."
        },
        {
            "key": "field_lp_show_whatsapp_float",
            "label": "Mostrar Botón Flotante de WhatsApp",
            "name": "lp_show_whatsapp_float",
            "type": "true_false",
            "ui": 1,
            "default_value": 1
        }
    ],
    "location": [
        [
            {
                "param": "options_page",
                "operator": "==",
                "value": "latin-party-settings"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "active": true
}